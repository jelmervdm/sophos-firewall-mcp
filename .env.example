# Sophos Firewall (SFOS) Connection Details
# Note: Ensure API Access is enabled under System > Administration > API Access
# and your client IP address is added to the Allowed IP Addresses whitelist.
SOPHOS_HOST=192.168.1.1
SOPHOS_PORT=4444
SOPHOS_USERNAME=admin
SOPHOS_PASSWORD=your_secure_password_here
SOPHOS_API_VERSION=2200.1
SOPHOS_VERIFY_SSL=false
SOPHOS_TIMEOUT=30

# Optional Router Configuration
USE_ROUTER=false
ROUTER_MODEL=BAAI/bge-small-en-v1.5
